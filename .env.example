# --- Required ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_SECRET=generate-a-long-random-string

# --- First-run admin owner (used only to seed the account the first time) ---
ADMIN_EMAIL=i.alhindawi5@gmail.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Email notifications & password-reset codes (Gmail App Password) ---
GMAIL_USER=i.alhindawi5@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# NOTIFY_EMAIL=where-to-send-contact-notifications@example.com  (defaults to the owner email)

# --- Image uploads (auto-set by Vercel when you add a Blob store) ---
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Cloudflare Turnstile (bot challenge on admin login; optional) ---
# Create a widget at https://dash.cloudflare.com → Turnstile. Add the hostname
# iman-hindawi.vercel.app. Leaving these unset keeps the login working without it.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...        # public, sent to the browser
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...      # secret, server-side only
# Both must come from the SAME widget. Set TURNSTILE_DEBUG=1 to show Cloudflare's
# error-codes on the login screen while diagnosing a rejected challenge.
# TURNSTILE_DEBUG=1

# --- Screenshot capture (optional; higher Microlink limits) ---
# MICROLINK_API_KEY=your-microlink-key

# --- Google Analytics figures in the dashboard (optional) ---
# The website counts visits with the Measurement ID set in the dashboard
# (Analytics panel) — that needs nothing here. These two are only for showing
# the numbers inside /admin:
#   1. Google Cloud → create a service account → download its JSON key.
#   2. Google Analytics → Admin → Property access management → add that
#      service account's email as a Viewer.
#   3. Set both variables below and redeploy.
# GA_PROPERTY_ID=123456789                      # numeric GA4 property ID
# GA_SERVICE_ACCOUNT_JSON={"type":"service_account", ... }   # the whole key file
# Or, instead of the JSON, the two fields from it:
# GA_CLIENT_EMAIL=name@project.iam.gserviceaccount.com
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
